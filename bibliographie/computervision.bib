@article{yuEmbodiedHeritageIntegrating2025a,
  title = {Embodied Heritage by Integrating Digital and Physical Visualization of Eaves Tiles to Display Cultural Heritage Kinship},
  author = {Yu, Jian and Ye, Yilin and Tang, Chen and Liu, Yuanbang and Ruan, Chenxi and Feng, Jingxue and Zhang, Kaihao and Zeng, Wei},
  year = {2025},
  month = jul,
  journal = {npj Heritage Science},
  volume = {13},
  doi = {10.1038/s40494-025-01942-1},
  abstract = {Eave tiles, affixed to the ends of ancient Chinese roofs, exhibit distinctive motifs and artistic beauty. However, the passage of time and insufficient documentation hinder evolutionary analysis of motifs. We curate a high-quality dataset comprising 926 cloud-motif eave tiles selected from over 4000 images. A thorough analysis of these cloud motifs reveals evolutionary patterns and connections spanning over 2000 years of Chinese history. We develop a 3D interactive visualization system that facilitates cross-dynasty exploration of eave tiles, leveraging generative AI for motif restoration and prediction. Furthermore, we investigate the transition from digital visualization to physical representation using thermochromic materials for digital light processing 3D printing. Integrating digital and physical visualization enhances the understanding of heritage evolution and interconnections, while offering new perspectives and methodologies for converting digital heritage into tangible forms.},
  keywords = {CV},
  file = {/home/lucie-ledieu/snap/zotero-snap/common/Zotero/storage/CFDRZ5MD/Yu et al. - 2025 - Embodied heritage by integrating digital and physical visualization of eaves tiles to display cultur.pdf}
}
