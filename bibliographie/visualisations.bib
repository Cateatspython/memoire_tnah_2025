@article{windhagerVisualizationCulturalHeritage2019,
  title = {Visualization of {{Cultural Heritage Collection Data}}: {{State}} of the {{Art}} and {{Future Challenges}}},
  shorttitle = {Visualization of {{Cultural Heritage Collection Data}}},
  author = {Windhager, Florian and Federico, Paolo and Schreder, Günther and Glinka, Katrin and Dörk, Marian and Miksch, Silvia and Mayr, Eva},
  date = {2019-06},
  journaltitle = {IEEE Transactions on Visualization and Computer Graphics},
  volume = {25},
  number = {6},
  pages = {2311--2330},
  issn = {1941-0506},
  doi = {10.1109/TVCG.2018.2830759},
  url = {https://ieeexplore.ieee.org/document/8352050},
  urldate = {2025-08-04},
  abstract = {After decades of digitization, large cultural heritage collections have emerged on the web, which contain massive stocks of content from galleries, libraries, archives, and museums. This increase in digital cultural heritage data promises new modes of analysis and increased levels of access for academic scholars and casual users alike. Going beyond the standard representations of search-centric and grid-based interfaces, a multitude of approaches has recently started to enable visual access to cultural collections, and to explore them as complex and comprehensive information spaces by the means of interactive visualizations. In contrast to conventional web interfaces, we witness a widening spectrum of innovative visualization types specially designed for rich collections from the cultural heritage sector. This new class of information visualizations gives rise to a notable diversity of interaction and representation techniques while lending currency and urgency to a discussion about principles such as serendipity, generosity, and criticality in connection with visualization design. With this survey, we review information visualization approaches to digital cultural heritage collections and reflect on the state of the art in techniques and design choices. We contextualize our survey with humanist perspectives on the field and point out opportunities for future research.},
  keywords = {VZ},
  file = {/home/lucie-ledieu/snap/zotero-snap/common/Zotero/storage/UXZXB27B/Windhager et al. - 2019 - Visualization of Cultural Heritage Collection Data State of the Art and Future Challenges.pdf}
}

@article{yuEmbodiedHeritageIntegrating2025,
  title = {Embodied Heritage by Integrating Digital and Physical Visualization of Eaves Tiles to Display Cultural Heritage Kinship},
  author = {Yu, Jian and Ye, Yilin and Tang, Chen and Liu, Yuanbang and Ruan, Chenxi and Feng, Jingxue and Zhang, Kaihao and Zeng, Wei},
  date = {2025-07-19},
  journaltitle = {npj Heritage Science},
  volume = {13},
  number = {1},
  pages = {354},
  publisher = {Nature Publishing Group},
  issn = {3059-3220},
  doi = {10.1038/s40494-025-01942-1},
  url = {https://www.nature.com/articles/s40494-025-01942-1},
  urldate = {2025-08-25},
  abstract = {Eave tiles, affixed to the ends of ancient Chinese roofs, exhibit distinctive motifs and artistic beauty. However, the passage of time and insufficient documentation hinder evolutionary analysis of motifs. We curate a high-quality dataset comprising 926 cloud-motif eave tiles selected from over 4000 images. A thorough analysis of these cloud motifs reveals evolutionary patterns and connections spanning over 2000 years of Chinese history. We develop a 3D interactive visualization system that facilitates cross-dynasty exploration of eave tiles, leveraging generative AI for motif restoration and prediction. Furthermore, we investigate the transition from digital visualization to physical representation using thermochromic materials for digital light processing 3D printing. Integrating digital and physical visualization enhances the understanding of heritage evolution and interconnections, while offering new perspectives and methodologies for converting digital heritage into tangible forms.},
  keywords = {VZ},
  file = {/home/lucie-ledieu/snap/zotero-snap/common/Zotero/storage/PA4K8NZN/Yu et al. - 2025 - Embodied heritage by integrating digital and physical visualization of eaves tiles to display cultur.pdf}
}
